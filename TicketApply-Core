# ==================== نافذة كتابة السبب للقبول أو الرفض ====================
class ReasonModal(discord.ui.Modal):
    def __init__(self, action_type: str, original_embed: discord.Embed, member_to_notify: discord.User):
        super().__init__(title=f"سبب الـ {action_type}")
        self.action_type = action_type
        self.original_embed = original_embed
        self.member_to_notify = member_to_notify

        self.reason_input = discord.ui.TextInput(
            label="اكتب السبب هنا:",
            style=discord.TextStyle.paragraph,
            placeholder="اكتب تفاصيل القبول أو الرفض...",
            required=True,
            max_length=500
        )
        self.add_item(self.reason_input)

    async def on_submit(self, interaction: discord.Interaction):
        reason = self.reason_input.value
        
        self.original_embed.add_field(
            name=f"حالة الطلب: {self.action_type}",
            value=f"**السبب:** {reason}\n**بواسطة:** {interaction.user.mention}",
            inline=False
        )
        
        if self.action_type == "قبول":
            self.original_embed.color = discord.Color.green()
        else:
            self.original_embed.color = discord.Color.red()

        # إيقاف الأزرار بعد اتخاذ القرار
        await interaction.message.edit(embed=self.original_embed, view=None)
        await interaction.response.send_message(f"✅ تم إرسال القرار بنجاح.", ephemeral=True)

        try:
            await self.member_to_notify.send(f"📬 تم **{self.action_type}** تقديمك.\n**السبب:** {reason}")
        except:
            pass


# ==================== أزرار القبول والرفض في روم المراجعة (للإداريين فقط) ====================
class ReviewDecisionView(discord.ui.View):
    def __init__(self, applicant: discord.User):
        super().__init__(timeout=None)
        self.applicant = applicant

    @discord.ui.button(label="قبول", style=discord.ButtonStyle.success, emoji="✅", custom_id="accept_application")
    async def accept_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not interaction.user.guild_permissions.administrator:
            await interaction.response.send_message("❌ عذراً، هذا الزر مخصص للإداريين فقط!", ephemeral=True)
            return
        await interaction.response.send_modal(ReasonModal("قبول", interaction.message.embeds[0], self.applicant))

    @discord.ui.button(label="رفض", style=discord.ButtonStyle.danger, emoji="❌", custom_id="reject_application")
    async def reject_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not interaction.user.guild_permissions.administrator:
            await interaction.response.send_message("❌ عذراً، هذا الزر مخصص للإداريين فقط!", ephemeral=True)
            return
        await interaction.response.send_modal(ReasonModal("رفض", interaction.message.embeds[0], self.applicant))


# ==================== نظام التقديم التفاعلي على الخاص ====================
async def handle_application(member: discord.Member, track_name: str):
    try:
        await member.send(f"أهلاً بك في التقديم على مسار **{track_name}**.\nالرجاء الإجابة على الأسئلة التالية تباعاً:")
    except:
        return 

    def check(m):
        return m.author == member and isinstance(m.channel, discord.DMChannel)

    answers = []
    
    if track_name == "Developer":
        questions = [
            "1️⃣ ما هو اسمك الحقيقي؟",
            "2️⃣ ما هو عمرك الحقيقي؟",
            "3️⃣ ما هي خبراتك؟",
            "4️⃣ ما هي لغاتك البرمجية؟",
            "5️⃣ هل تقدر تسوي بوت في أسبوع؟"
        ]
        time_limit = "-# ⏱️ معك ٢٠ دقائق للحل و ممنوع وسيلة مساعدة"
    elif track_name == "Moderator":
        questions = [
            "1️⃣ ما هو اسمك الحقيقي؟",
            "2️⃣ ما هو عمرك الحقيقي؟",
            "3️⃣ ما هي خبراتك؟",
            "4️⃣ لو صاحب البث تهاوش مع واحد من البث ايش تصرفك؟",
            "5️⃣ لو اثنين تهاوشوا و صاحب البث طلب منك تغير الكاتقوري ايش تصرفك؟"
        ]
        time_limit = "-# ⏱️ معك ١٠ دقائق للحل"
    elif track_name == "Event Management":
        questions = [
            "1️⃣ ما هو اسمك الحقيقي؟",
            "2️⃣ ما هو عمرك الحقيقي؟",
            "3️⃣ ما هي خبراتك؟",
            "4️⃣ هل تقدر تسوي بنر خلال ١٥ دقيقة؟",
            "5️⃣ كم تاخذ منك الصورة للايفنت؟"
        ]
        time_limit = "-# ⏱ معك ١٥ دقيقة للحل"
    elif track_name == "Administration":
        questions = [
            "1️⃣ ما هو اسمك الحقيقي؟",
            "2️⃣ ما هو عمرك الحقيقي؟",
            "3️⃣ ايش بلدك؟",
            "4️⃣ هل كنت إداري سابق عند احد؟",
            "5️⃣ إذا مسؤول الادارة قال لك سوي شي خطأ و ممنوع ايش تصرفك؟",
            "6️⃣ خبراتك؟",
            "7️⃣ لو حد كان حاط صورة +18 ايش تصرفك؟",
            "8️⃣ اثنين تهاوشو واحد إداري و الثاني شخص عادي ايش تصرفك؟",
            "9️⃣ لو قال لك مبرمج برمج إنت أنا روحت ايش تصرفك؟",
            "🔟 لو مسؤول الادارة و مبرمج تهاوشو ايش تصرفك؟"
        ]
        time_limit = "-# ⏱️ معك 10 ثواني للجواب على الاسئلة"
    else:
        questions = ["1️⃣ ما هو اسمك الحقيقي؟", "2️⃣ ما هو عمرك الحقيقي؟", "3️⃣ ما هي خبراتك؟"]
        time_limit = "-# ⏱ أجب على الأسئلة"

    for q in questions:
        await member.send(f"{q}\n{time_limit}")
        try:
            msg = await bot.wait_for('message', timeout=1200.0, check=check)
            answers.append(msg.content)
        except asyncio.TimeoutError:
            await member.send("⏳ انتهى الوقت المخصص للأسئلة.")
            return

    await member.send("✅ شكراً لك! تم إرسال نموذجك إلى الإدارة بنجاح لمراجعته.")

    review_channel = bot.get_channel(REVIEW_CHANNEL_ID)
    if review_channel:
        embed = discord.Embed(
            title=f"📋 نموذج تقديم جديد: {track_name}",
            description=f"**مقدم الطلب:** {member.mention} (`{member.id}`)",
            color=discord.Color.from_rgb(255, 204, 0)
        )
        for i, q_text in enumerate(questions):
            ans = answers[i] if i < len(answers) else "لايوجد"
            embed.add_field(name=q_text, value=ans, inline=False)
        
        view = ReviewDecisionView(member)
        await review_channel.send(embed=embed, view=view)


