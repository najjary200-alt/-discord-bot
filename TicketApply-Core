# مهام مراقبة منتصف الليل
async def check_time_at_midnight():
    await bot.wait_until_ready()
    while not bot.is_closed():
        now = datetime.now()
        if now.hour == 0 and now.minute == 0:
            for guild in bot.guilds:
                for channel in guild.text_channels:
                    try:
                        await channel.send("🔔 منتصف الليل وصل! انتهى اليوم وبدا يوم جديد يا عيال.")
                        break
                    except:
                        continue
            await asyncio.sleep(61)
        await asyncio.sleep(30)

@bot.event
async def on_ready():
    print(f"Logged in successfully as {bot.user}")
    bot.loop.create_task(check_time_at_midnight())

